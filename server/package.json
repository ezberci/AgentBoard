{
  "name": "@agentboard/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "build": "tsc --noEmit",
    "check": "tsc --noEmit && npm run test",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "prisma generate --schema=src/prisma/schema.prisma",
    "db:migrate": "prisma migrate dev --schema=src/prisma/schema.prisma",
    "db:seed": "tsx src/prisma/seed.ts",
    "mcp": "tsx src/mcp/index.ts"
  },
  "dependencies": {
    "@hono/node-server": "^1.13.7",
    "@hono/zod-validator": "^0.4.1",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@prisma/client": "^5.22.0",
    "camelcase-keys": "^10.0.2",
    "dotenv": "^16.4.5",
    "hono": "^4.6.9",
    "pino": "^9.5.0",
    "pino-pretty": "^13.0.0",
    "snakecase-keys": "^9.0.2",
    "ws": "^8.18.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "@types/supertest": "^6.0.2",
    "@types/ws": "^8.5.13",
    "@vitest/coverage-v8": "^2.1.5",
    "prisma": "^5.22.0",
    "supertest": "^7.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^2.1.5"
  }
}
